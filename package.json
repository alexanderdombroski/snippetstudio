{
  "name": "snippetstudio-root",
  "description": "VS Code's Missing Snippet Editor",
  "author": "Alex Dombroski",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "package": "npm run package --workspace snippetstudio && npm run bundle --workspace snippetstudio",
    "lint": "oxlint",
    "check-types": "npm-run-all check-types:*",
    "check-types:packages": "npm run check-types --workspaces --if-present",
    "check-types:configs": "tsc --noEmit",
    "test": "npm run test --workspaces --if-present",
    "test:setup": "node .vitest/createEnv.ts",
    "test:ui": "vitest watch --ui --coverage",
    "coverage": "npm run coverage --workspaces --if-present",
    "coverage:publish": "npm run coverage:publish --workspaces --if-present",
    "prepare": "node .husky/prepare.ts"
  },
  "workspaces": [
    "packages/*"
  ], 
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-minify": "^3.0.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@vscode/vsce-sign@2.1.0": true,
    "keytar@7.9.0": true,
    "core-js@3.50.0": true,
    "@swc/core@1.16.2": true
  }
}
