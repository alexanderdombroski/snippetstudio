// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"dependsOn": ["tsc", "vite"],
			"dependsOrder": "parallel",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "vite",
			"command": "npx vite build --watch --mode development",
			"options": {
				"cwd": "${workspaceFolder}/packages/extension"
			},
			"group": "build",
			"isBackground": true,
			"problemMatcher": {
			"owner": "vite",
			"pattern": {
				"regexp": ".",
			},
			"background": {
				"activeOnStart": true,
				"beginsPattern": "^.*build started.*$",
				"endsPattern": "^.*built in \\d+.*$"
			}
		},
			"presentation": {
				"group": "watch"
			}
		},
		{
			"type": "shell",
			"label": "tsc",
			"command": "npx tsc --watch",
			"options": {
				"cwd": "${workspaceFolder}/packages/extension"
			},
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"group": "watch"
			}
		}
	]
}
