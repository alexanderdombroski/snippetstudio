{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/vite.config.ts",
    "**/vite.config.mts",
    "**/vitest.config.ts",
