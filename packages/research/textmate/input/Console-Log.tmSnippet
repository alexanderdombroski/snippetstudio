<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>content</key>
  <string>console.log('${1:message}');
${2}</string>
  <key>name</key>
  <string>Console Log</string>
  <key>tabTrigger</key>
  <string>log</string>
  <key>scope</key>
  <array>
    <string>source.js</string>
  </array>
</dict>
</plist>
